# QRnegie configuration. Every setting is optional; these are the defaults.
# Copy to an env file and pass it with --env-file. See
# DEPLOYMENT.md#configuration.

# Port the application listens on
PORT=3000

# Address the application listens on
HOST=0.0.0.0

# The site's public origin, used in the image addresses the MCP server returns
PUBLIC_URL=https://qrnegie.andrew.cmu.edu
