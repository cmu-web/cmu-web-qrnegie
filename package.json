{
  "name": "cmu-web-qrnegie",
  "version": "0.3.0",
  "private": true,
  "description": "Scotty, Beam Me There. Scotty and plain QR codes for Carnegie Mellon.",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:node": "node scripts/check-node-version.mjs",
    "check:opengraph": "node scripts/opengraph.mjs --check",
    "opengraph": "node scripts/opengraph.mjs",
    "check": "npm run check:node && npm run lint && npm run format:check && npm run check:opengraph && npm run typecheck && npm test && npm run check:docs",
    "examples": "npm run build && node scripts/render-examples.mjs",
    "docs": "npm run build && node scripts/documentation.mjs",
    "check:docs": "npm run build && node scripts/documentation.mjs --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "bootstrap-icons": "^1.13.2",
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@j178/prek": "^0.5.9",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "jsqr": "^1.4.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "license": "BSD-3-Clause",
  "allowScripts": {
    "esbuild": false
  }
}
